{
  "name": "playwright-capstone-project",
  "version": "1.0.0",
  "description": "Playwright Capstone Project with Allure Reporting and CI/CD",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ci": "playwright test --project=chromium --workers=1",
    "test:chrome": "playwright test --project=chromium --workers=1",
    "test:firefox": "playwright test --project=firefox --workers=1",
    "test:webkit": "playwright test --project=webkit --workers=1",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "allure",
    "ci-cd"
  ],
  "author": "Shiny Belsiya",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "allure-playwright": "^3.3.2"
  }
}