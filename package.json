{
  "name": "playwright-capstone-project",

  "version": "1.0.0",

  "description": "Playwright Capstone Project with Allure Reporting",

  "main": "index.js",

  "scripts": {

    "test": "playwright test",

    "test:ci": "playwright test --workers=1",

    "report": "playwright show-report",

    "allure:generate": "allure generate allure-results --clean -o reports/allure-report",

    "allure:open": "allure open reports/allure-report",

    "codegen": "playwright codegen https://opensource-demo.orangehrmlive.com/web/index.php/auth/login"

  },

  "keywords": [

    "playwright",

    "automation",

    "testing",

    "allure",

    "capstone"

  ],

  "author": "Shiny Belsiya",

  "license": "ISC",

  "devDependencies": {

    "@playwright/test": "^1.52.0",

    "allure-commandline": "^2.34.1",

    "allure-playwright": "^3.3.3"

  }
}